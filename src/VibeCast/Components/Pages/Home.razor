@page "/"
@rendermode InteractiveServer
@inject IDbContextFactory<AppDbContext> DbContextFactory
@inject EpisodeStateService EpisodeStateService
@inject ShowNotesSanitizer ShowNotesSanitizer
@inject DownloadQueue DownloadQueue
@inject DownloadProgressTracker ProgressTracker
@inject PlaybackService PlaybackService
@inject AppConfig Config
@using Microsoft.EntityFrameworkCore
@using VibeCast.AppHost
@using VibeCast.Data
@using VibeCast.Downloads
@using VibeCast.Episodes
@implements IDisposable

<PageTitle>VibeCast</PageTitle>

<div class="library">
    <nav class="feed-sidebar">
        <h1 class="app-brand"><img src="images/vibecast.png" alt="" class="app-logo" />VibeCast</h1>
        <ul>
            <li>
                <button class="@(selectedFeedId is null ? "selected" : null)" @onclick="() => SelectFeedAsync(null)">
                    <span class="feed-name">All feeds</span>
                    <span class="feed-metrics">
                        <span class="feed-time" title="Total time of new episodes">@FormatTotalTime(feeds?.Sum(f => f.UnplayedSeconds) ?? 0)</span>
                        <span class="count">@(feeds?.Sum(f => f.ActiveCount) ?? 0)</span>
                    </span>
                </button>
            </li>
            <li class="feed-filter">
                <label title="Hide feeds with no unplayed episodes">
                    <input type="checkbox" class="toggle" checked="@Config.HideEmptyFeeds" @onchange="ToggleHideEmptyFeedsAsync" />
                    Hide empty feeds
                </label>
            </li>
            @if (feeds is not null)
            {
                @foreach (var feed in feeds.Where(f => !Config.HideEmptyFeeds || f.ActiveCount > 0))
                {
                    <li>
                        <button class="@(selectedFeedId == feed.Id ? "selected" : null)" @onclick="() => SelectFeedAsync(feed.Id)">
                            <span class="feed-name" title="@feed.Title">
                                @if (feed.HasArtwork)
                                {
                                    <img class="feed-art" src="/media/feeds/@(feed.Id)/artwork" alt="" />
                                }
                                <span class="feed-title-text">@feed.Title</span>
                            </span>
                            <span class="feed-metrics">
                                <span class="feed-time" title="Total time of new episodes">@FormatTotalTime(feed.UnplayedSeconds)</span>
                                <span class="count">@feed.ActiveCount</span>
                            </span>
                        </button>
                    </li>
                }
            }
        </ul>
        <p><a href="/feeds">Manage feeds</a></p>
        <p><a href="/downloads">Downloads</a></p>
        <p><a href="/settings">Settings</a></p>
    </nav>

    <section class="episode-list">
        <div class="episode-list-header">
            <h2>Episodes</h2>
            <div class="episode-list-controls">
                <div class="filter-menu" @onkeydown="OnFilterMenuKeyDown">
                    <button class="@(Filters.ChangedCount() > 0 ? "filter-button filtered" : "filter-button")"
                            aria-haspopup="menu" aria-expanded="@(filterMenuOpen ? "true" : "false")"
                            title="Choose which episodes the list shows"
                            @onclick="() => filterMenuOpen = !filterMenuOpen">
                        @FilterButtonText
                    </button>
                    @if (filterMenuOpen)
                    {
                        <div class="filter-backdrop" @onclick="() => filterMenuOpen = false"></div>
                        <div class="filter-dropdown" role="menu">
                            <div class="filter-group-label">Status</div>
                            @FilterItem("Unplayed", "Episodes not yet played/archived", Filters.Unplayed, v => Filters.Unplayed = v)
                            @FilterItem("Archived", "Played episodes moved to the archive", Filters.Archived, v => Filters.Archived = v)
                            <div class="filter-group-label">Type</div>
                            @FilterItem("Shorts", "YouTube Shorts (5 minutes or less)", Filters.Shorts, v => Filters.Shorts = v)
                            @FilterItem("Longs", "Everything that isn't a Short, podcasts included", Filters.Longs, v => Filters.Longs = v)
                            <div class="filter-group-label">Source</div>
                            @FilterItem("Downloaded", "Podcast episodes on disk", Filters.Downloaded, v => Filters.Downloaded = v)
                            @FilterItem("Not downloaded", "Podcast episodes not on disk (queued, failed, or past the auto-download cutoff)", Filters.NotDownloaded, v => Filters.NotDownloaded = v)
                            @FilterItem("Streamed", "YouTube videos that have aired", Filters.Streamed, v => Filters.Streamed = v)
                            @FilterItem("Upcoming", "YouTube premieres that haven't aired yet", Filters.Upcoming, v => Filters.Upcoming = v)
                            <div class="filter-group-label">Progress</div>
                            @FilterItem("In progress only", "Only episodes with a saved resume position", Filters.InProgressOnly, v => Filters.InProgressOnly = v)
                            <hr />
                            <button class="filter-reset" role="menuitem" disabled="@(Filters.ChangedCount() == 0)" @onclick="ResetFiltersAsync">
                                Reset to defaults
                            </button>
                        </div>
                    }
                </div>
                <button @onclick="ToggleSortOrderAsync" title="Toggle sort order">
                    @(Config.EpisodeSortDescending ? "Newest first ↓" : "Oldest first ↑")
                </button>
            </div>
        </div>
        <input type="search" class="episode-search" placeholder="Search titles" aria-label="Search episode titles"
               @bind="searchText" @bind:event="oninput" @bind:after="OnSearchChangedAsync" />

        @if (episodes is null)
        {
            <p>Loading...</p>
        }
        else if (episodes.Count == 0)
        {
            <p>@(IsListNarrowed ? "No episodes match the current filters." : "No episodes yet.")</p>
        }
        else
        {
            <ul>
                @foreach (var episode in episodes)
                {
                    <li class="@(selectedEpisodeId == episode.Id ? "selected" : null)" @onclick="() => SelectEpisodeAsync(episode.Id)">
                        <div class="episode-title">
                            @episode.Title
                            @if (episode.IsShort)
                            {
                                <span class="shorts-badge" title="YouTube Short">Short</span>
                            }
                            @if (episode.ScheduledStartUtc is not null)
                            {
                                <span class="upcoming-badge" title="@UpcomingTooltip(episode.ScheduledStartUtc)">Upcoming</span>
                            }
                            @if (episode.IsStreaming)
                            {
                                <span class="streaming-badge" title="Streams from YouTube">Streaming</span>
                            }
                            @if (episode.IsDownloaded)
                            {
                                <span class="downloaded-badge" title="Downloaded and ready to play offline">Downloaded</span>
                            }
                            @if (episode.ResumeSeconds > 0)
                            {
                                <span class="position-badge" title="Resumes from @FormatDuration(episode.ResumeSeconds)">@FormatDuration(episode.ResumeSeconds)</span>
                            }
                            @if (episode.IsArchived)
                            {
                                <span class="archived-badge" title="Played and archived">Archived</span>
                            }
                        </div>
                        <div class="episode-meta">
                            @episode.FeedTitle &middot; @episode.PublishedAtUtc.ToLocalTime().ToString("MMM d, yyyy") &middot; @FormatDurationOrSchedule(episode.DurationSeconds, episode.ScheduledStartUtc) &middot; @FormatFileSize(episode.FileSizeBytes)
                        </div>
                    </li>
                }
            </ul>

            @if (CanMarkFeedAsPlayed)
            {
                <div class="episode-list-actions">
                    @if (confirmingMarkAllPlayed)
                    {
                        <span>Mark all @episodes.Count episodes in this feed as played?</span>
                        <button class="danger" @onclick="MarkFeedAsPlayedAsync" disabled="@isMarkingAllPlayed">Yes, mark all</button>
                        <button @onclick="() => confirmingMarkAllPlayed = false" disabled="@isMarkingAllPlayed">Cancel</button>
                    }
                    else
                    {
                        <button title="Mark every episode in this feed as played, cancel its pending downloads, and archive it"
                                @onclick="() => confirmingMarkAllPlayed = true">
                            Mark all as played
                        </button>
                    }
                </div>
            }
        }
    </section>

    <section class="episode-detail">
        @if (detail is null)
        {
            <p>Select an episode.</p>
        }
        else
        {
            <h2>
                @detail.Title
                @if (detail.IsShort)
                {
                    <span class="shorts-badge" title="YouTube Short">Short</span>
                }
                @if (detail.ScheduledStartUtc is not null)
                {
                    <span class="upcoming-badge" title="@UpcomingTooltip(detail.ScheduledStartUtc)">Upcoming</span>
                }
            </h2>
            <p class="episode-meta">
                @detail.FeedTitle &middot; @detail.PublishedAtUtc.ToLocalTime().ToString("MMM d, yyyy") &middot; @FormatDurationOrSchedule(detail.DurationSeconds, detail.ScheduledStartUtc) &middot; @FormatFileSize(detail.FileSizeBytes)
            </p>

            <p>
                <label>
                    <input type="checkbox" checked="@detail.IsPlayed" @onchange="() => TogglePlayedAsync(detail)" />
                    Played
                </label>
                @if (detail.IsArchived)
                {
                    <button @onclick="() => UnarchiveAsync(detail.Id)">Unarchive</button>
                }
            </p>

            @if (detail.IsRss)
            {
                <p>
                    @GetDownloadStatusText(detail)
                    @if (CanManuallyDownload(detail))
                    {
                        <button @onclick="() => DownloadNow(detail)">Download</button>
                    }
                    <button class="primary" @onclick="() => PlayRssAsync(detail.Id)">Play</button>
                </p>
            }
            else
            {
                <p>
                    <button class="primary" @onclick="() => PlayYouTubeAsync(detail.Id)">Play</button>
                </p>
            }

            <div class="show-notes">
                @((MarkupString)ShowNotesSanitizer.Sanitize(detail.DescriptionHtml))
            </div>
        }
    </section>
</div>

@code {
    private List<FeedSummary>? feeds;
    private List<EpisodeListItem>? episodes;
    private EpisodeDetail? detail;
    private int? selectedFeedId;
    private int? selectedEpisodeId;
    private bool filterMenuOpen;
    private string searchText = string.Empty;
    private int loadVersion;
    private bool confirmingMarkAllPlayed;
    private bool isMarkingAllPlayed;
    private readonly CancellationTokenSource cts = new();

    private EpisodeFilters Filters => Config.EpisodeFilters;

    // The count flags a list that's hiding something, so it isn't mistaken for empty.
    private string FilterButtonText =>
        Filters.ChangedCount() is > 0 and var changed ? $"Filters ({changed}) ▾" : "Filters ▾";

    // True when filters or the search hide part of the feed's active list.
    private bool IsListNarrowed => Filters.ChangedCount() > 0 || !string.IsNullOrWhiteSpace(searchText);

    // Bulk mark-as-played is a per-feed action, so it needs a feed selected (not "All
    // feeds"). It acts on the whole feed, so it's only offered when the list shows exactly
    // that feed's active episodes, with no filter or search hiding any and no archived
    // rows mixed in, so the confirmation count is true. Short lists aren't worth the
    // risk of a mis-click.
    private bool CanMarkFeedAsPlayed =>
        !IsListNarrowed && selectedFeedId is not null && episodes is { Count: > 5 };

    protected override async Task OnInitializedAsync()
    {
        ProgressTracker.Changed += OnProgressChanged;
        PlaybackService.PositionSaved += OnPositionSaved;
        await LoadFeedsAsync();
        await LoadEpisodesAsync();
    }

    private void OnProgressChanged() => InvokeAsync(StateHasChanged);

    // A pause/stop in the player just saved a resume position; patch that row's badge in
    // place rather than re-querying the whole list.
    private void OnPositionSaved(int episodeId, int positionSeconds) => InvokeAsync(() =>
    {
        var index = episodes?.FindIndex(e => e.Id == episodeId) ?? -1;
        if (index >= 0 && episodes![index].ResumeSeconds != positionSeconds)
        {
            episodes[index] = episodes[index] with { ResumeSeconds = positionSeconds };
            StateHasChanged();
        }
    });

    private async Task LoadFeedsAsync()
    {
        await using var db = await DbContextFactory.CreateDbContextAsync(cts.Token);
        feeds = await db.Feeds
            .OrderBy(f => f.Title)
            .Select(f => new FeedSummary(
                f.Id,
                f.Title ?? f.OriginalUrl,
                f.Episodes.Count(e => !e.IsArchived),
                f.Episodes.Where(e => !e.IsArchived).Sum(e => e.DurationSeconds) ?? 0,
                f.ArtworkFileName != null))
            .ToListAsync(cts.Token);
    }

    private async Task LoadEpisodesAsync()
    {
        // Search-as-you-type can start a load before the previous one finishes; only the
        // newest load may publish its rows.
        var version = ++loadVersion;
        var filters = Config.EpisodeFilters;

        await using var db = await DbContextFactory.CreateDbContextAsync(cts.Token);
        var query = filters.Apply(db.Episodes, searchText);

        if (selectedFeedId is { } feedId)
        {
            query = query.Where(e => e.FeedId == feedId);
        }

        query = Config.EpisodeSortDescending
            ? query.OrderByDescending(e => e.PublishedAtUtc)
            : query.OrderBy(e => e.PublishedAtUtc);

        var rows = await query
            .Select(e => new
            {
                e.Id,
                e.Title,
                FeedTitle = e.Feed.Title ?? e.Feed.OriginalUrl,
                e.PublishedAtUtc,
                e.DurationSeconds,
                e.ScheduledStartUtc,
                IsShort = e.EnclosureUrl == null && e.DurationSeconds != null && e.DurationSeconds <= EpisodeFilters.ShortMaxSeconds,
                IsYouTube = e.YouTubeVideoId != null,
                e.IsDownloaded,
                e.IsArchived,
                FeedSlug = e.Feed.Slug,
                e.DownloadedFileName,
                // Resume position only means something on an unplayed episode.
                ResumeSeconds = e.IsPlayed ? 0 : e.PlaybackPositionSeconds,
            })
            .Take(200)
            .ToListAsync(cts.Token);

        var items = new List<EpisodeListItem>(rows.Count);
        foreach (var r in rows)
        {
            // The flag can outlive the file (mark-as-played defers a locked delete), so
            // the badge -- and the Downloaded/Not downloaded filter -- follow what is
            // actually on disk.
            var fileSize = GetFileSize(r.FeedSlug, r.DownloadedFileName);
            var isOnDisk = r.IsDownloaded && fileSize is not null;
            if (!filters.MatchesSource(r.IsYouTube, r.ScheduledStartUtc is not null, isOnDisk))
            {
                continue;
            }

            var isStreaming = r.IsYouTube && r.ScheduledStartUtc is null;
            items.Add(new EpisodeListItem(r.Id, r.Title, r.FeedTitle, r.PublishedAtUtc, r.DurationSeconds, r.ScheduledStartUtc, r.IsShort, isStreaming, isOnDisk, r.IsArchived, fileSize, r.ResumeSeconds));
        }

        if (version == loadVersion)
        {
            episodes = items;
        }
    }

    private async Task SelectFeedAsync(int? feedId)
    {
        selectedFeedId = feedId;
        selectedEpisodeId = null;
        detail = null;
        confirmingMarkAllPlayed = false;
        await LoadEpisodesAsync();
    }

    private async Task ToggleHideEmptyFeedsAsync(ChangeEventArgs e)
    {
        Config.HideEmptyFeeds = e.Value is true;
        Config.Save();

        if (Config.HideEmptyFeeds && selectedFeedId is { } feedId
            && feeds?.SingleOrDefault(f => f.Id == feedId) is { ActiveCount: 0 })
        {
            await SelectFeedAsync(null);
        }
    }

    private async Task ToggleSortOrderAsync()
    {
        Config.EpisodeSortDescending = !Config.EpisodeSortDescending;
        Config.Save();
        await LoadEpisodesAsync();
    }

    // One checkable row of the Filters drop-down. Clicking toggles it and leaves the menu
    // open so several filters can be changed in one go.
    private RenderFragment FilterItem(string label, string title, bool isChecked, Action<bool> set) =>
        @<button class="filter-item" role="menuitemcheckbox" aria-checked="@(isChecked ? "true" : "false")" title="@title"
                 @onclick="() => SetFilterAsync(set, !isChecked)">
            <span class="filter-check" aria-hidden="true">@(isChecked ? "✓" : null)</span>
            @label
        </button>;

    private Task SetFilterAsync(Action<bool> set, bool value)
    {
        set(value);
        return OnFiltersChangedAsync(save: true);
    }

    private Task ResetFiltersAsync()
    {
        Filters.Reset();
        return OnFiltersChangedAsync(save: true);
    }

    private Task OnSearchChangedAsync() => OnFiltersChangedAsync(save: false);

    private async Task OnFiltersChangedAsync(bool save)
    {
        if (save)
        {
            Config.Save();
        }

        confirmingMarkAllPlayed = false;
        await LoadEpisodesAsync();

        // Keep the detail pane only while its episode is still in the list.
        if (selectedEpisodeId is { } id && episodes?.Any(e => e.Id == id) != true)
        {
            selectedEpisodeId = null;
            detail = null;
        }
    }

    private void OnFilterMenuKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            filterMenuOpen = false;
        }
    }

    private async Task SelectEpisodeAsync(int episodeId)
    {
        selectedEpisodeId = episodeId;

        await using var db = await DbContextFactory.CreateDbContextAsync(cts.Token);
        var row = await db.Episodes
            .Where(e => e.Id == episodeId)
            .Select(e => new
            {
                e.Id,
                e.Title,
                FeedTitle = e.Feed.Title ?? e.Feed.OriginalUrl,
                e.PublishedAtUtc,
                e.DurationSeconds,
                e.ScheduledStartUtc,
                e.DescriptionHtml,
                e.IsPlayed,
                e.IsArchived,
                IsRss = e.EnclosureUrl != null,
                IsShort = e.EnclosureUrl == null && e.DurationSeconds != null && e.DurationSeconds <= EpisodeFilters.ShortMaxSeconds,
                e.IsDownloaded,
                FeedSlug = e.Feed.Slug,
                e.DownloadedFileName,
            })
            .SingleOrDefaultAsync(cts.Token);

        detail = row is null
            ? null
            : new EpisodeDetail(row.Id, row.Title, row.FeedTitle, row.PublishedAtUtc, row.DurationSeconds, row.ScheduledStartUtc, row.DescriptionHtml, row.IsPlayed, row.IsArchived, row.IsRss, row.IsShort, row.IsDownloaded, GetFileSize(row.FeedSlug, row.DownloadedFileName));
    }

    private string GetDownloadStatusText(EpisodeDetail current)
    {
        var snapshot = ProgressTracker.Get(current.Id);
        if (snapshot is not null)
        {
            return snapshot.Status switch
            {
                DownloadStatus.Queued => "Queued for download.",
                DownloadStatus.Downloading => $"Downloading... {snapshot.FormatProgress()}",
                DownloadStatus.Completed => string.Empty,
                DownloadStatus.Failed => $"Download failed: {snapshot.ErrorMessage}",
                DownloadStatus.Canceled => "Download canceled.",
                _ => string.Empty,
            };
        }

        return current.IsDownloaded ? string.Empty : "Not downloaded.";
    }

    private bool CanManuallyDownload(EpisodeDetail current)
    {
        if (current.IsDownloaded)
        {
            return false;
        }

        var snapshot = ProgressTracker.Get(current.Id);
        return snapshot is null or { Status: DownloadStatus.Failed or DownloadStatus.Canceled };
    }

    private void DownloadNow(EpisodeDetail current) =>
        DownloadQueue.Enqueue(current.Id, current.Title, current.FeedTitle);

    private Task PlayRssAsync(int episodeId) => PlaybackService.RequestPlayRssAsync(episodeId, cts.Token);

    private Task PlayYouTubeAsync(int episodeId) => PlaybackService.PlayYouTubeAsync(episodeId, cts.Token);

    private async Task TogglePlayedAsync(EpisodeDetail current)
    {
        if (current.IsPlayed)
        {
            await UnarchiveAsync(current.Id);
        }
        else
        {
            await EpisodeStateService.MarkAsPlayedAsync(current.Id, cts.Token);
            await RefreshAfterMutationAsync(current.Id);
        }
    }

    private async Task UnarchiveAsync(int episodeId)
    {
        await EpisodeStateService.UnarchiveAsync(episodeId, cts.Token);
        await RefreshAfterMutationAsync(episodeId);
    }

    private async Task MarkFeedAsPlayedAsync()
    {
        if (selectedFeedId is not { } feedId)
        {
            return;
        }

        isMarkingAllPlayed = true;
        try
        {
            await EpisodeStateService.MarkFeedAsPlayedAsync(feedId, cts.Token);
        }
        finally
        {
            isMarkingAllPlayed = false;
            confirmingMarkAllPlayed = false;
        }

        // Everything in the list just moved to Archive, so whatever was selected is gone
        // from it -- drop the selection rather than reloading a detail pane for it.
        selectedEpisodeId = null;
        detail = null;
        await RefreshAfterMutationAsync(null);
    }

    private async Task RefreshAfterMutationAsync(int? episodeId)
    {
        await LoadFeedsAsync();

        if (Config.HideEmptyFeeds && selectedFeedId is { } feedId
            && feeds?.SingleOrDefault(f => f.Id == feedId) is { ActiveCount: 0 })
        {
            await SelectFeedAsync(null);
            return;
        }

        await LoadEpisodesAsync();

        if (episodeId is { } id && selectedEpisodeId == id)
        {
            await SelectEpisodeAsync(id);
        }
    }

    private static string FormatDuration(int? seconds)
    {
        if (seconds is null)
        {
            return string.Empty;
        }

        var span = TimeSpan.FromSeconds(seconds.Value);
        return span.TotalHours >= 1 ? span.ToString(@"h\:mm\:ss") : span.ToString(@"m\:ss");
    }

    // An unaired YouTube premiere has no real duration yet; show its scheduled air date
    // in the meta line in place of a "0:00" that would never be accurate.
    private static string FormatDurationOrSchedule(int? seconds, DateTime? scheduledStartUtc) =>
        scheduledStartUtc is { } start
            ? $"Airs {start.ToLocalTime():MMM d, yyyy}"
            : FormatDuration(seconds);

    // Total listening time of the active (new/unplayed) episodes, shown next to each feed
    // and the "All feeds" entry. Always "xh xm" so it aligns column-wise in the sidebar.
    private static string FormatTotalTime(long seconds)
    {
        var totalMinutes = (long)Math.Round(seconds / 60.0, MidpointRounding.AwayFromZero);
        return $"{totalMinutes / 60}h {totalMinutes % 60}m";
    }

    private static string UpcomingTooltip(DateTime? scheduledStartUtc) =>
        scheduledStartUtc is { } start
            ? $"Scheduled premiere — airs {start.ToLocalTime():MMM d, yyyy h:mm tt}"
            : "Scheduled premiere";

    private static long? GetFileSize(string feedSlug, string? downloadedFileName)
    {
        if (downloadedFileName is null)
        {
            return null;
        }

        var filePath = Path.Combine(AppPaths.DownloadsDirectory, feedSlug, downloadedFileName);
        var info = new FileInfo(filePath);
        return info.Exists ? info.Length : null;
    }

    private static string FormatFileSize(long? bytes)
    {
        if (bytes is null)
        {
            return string.Empty;
        }

        const double kb = 1024;
        const double mb = kb * 1024;
        const double gb = mb * 1024;

        return bytes.Value switch
        {
            >= (long)gb => $"{bytes.Value / gb:0.00} GB",
            >= (long)mb => $"{bytes.Value / mb:0.00} MB",
            _ => $"{bytes.Value / kb:0.00} KB",
        };
    }

    public void Dispose()
    {
        ProgressTracker.Changed -= OnProgressChanged;
        PlaybackService.PositionSaved -= OnPositionSaved;
        cts.Cancel();
        cts.Dispose();
    }

    private sealed record FeedSummary(int Id, string Title, int ActiveCount, long UnplayedSeconds, bool HasArtwork);

    private sealed record EpisodeListItem(int Id, string Title, string FeedTitle, DateTime PublishedAtUtc, int? DurationSeconds, DateTime? ScheduledStartUtc, bool IsShort, bool IsStreaming, bool IsDownloaded, bool IsArchived, long? FileSizeBytes, int ResumeSeconds);

    private sealed record EpisodeDetail(int Id, string Title, string FeedTitle, DateTime PublishedAtUtc, int? DurationSeconds, DateTime? ScheduledStartUtc, string? DescriptionHtml, bool IsPlayed, bool IsArchived, bool IsRss, bool IsShort, bool IsDownloaded, long? FileSizeBytes);
}
