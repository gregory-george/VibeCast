@page "/feeds"
@rendermode InteractiveServer
@inject FeedSubscriptionService SubscriptionService
@inject FeedRefreshService RefreshService
@inject IDbContextFactory<AppDbContext> DbContextFactory
@inject AppConfig Config
@using Microsoft.EntityFrameworkCore
@using VibeCast.AppHost
@using VibeCast.Data
@using VibeCast.Feeds
@implements IDisposable

<PageTitle>Feeds - VibeCast</PageTitle>

<div class="page">

<h1>Feeds</h1>

<p><a href="/">&larr; Back to library</a></p>

<p>
    <input @bind="newFeedUrl" @bind:event="oninput" placeholder="Podcast RSS or YouTube channel URL" style="width: 28rem;" />
    <button class="primary" @onclick="AddFeedAsync" disabled="@isAdding">Add</button>
</p>

@if (!string.IsNullOrEmpty(statusMessage))
{
    <p>@statusMessage</p>
}

<p>
    <button @onclick="RefreshAllAsync" disabled="@isRefreshing">Refresh all</button>
    @if (isRefreshing)
    {
        <span> refreshing...</span>
    }
    &mdash; <a href="/settings">Settings</a>
</p>

@if (feeds is null)
{
    <p>Loading...</p>
}
else if (feeds.Count == 0)
{
    <p>No feeds yet.</p>
}
else
{
    <table>
        <thead>
            <tr>
                <th></th>
                @foreach (var column in SortColumns)
                {
                    <th class="sortable" aria-sort="@(ActiveColumn.Key == column.Key ? (Config.FeedSortDescending ? "descending" : "ascending") : "none")">
                        <button @onclick="() => SortByAsync(column)" title="Sort by @column.Label">
                            @column.Label
                            <span class="sort-arrow">@(ActiveColumn.Key == column.Key && Config.FeedSortDescending ? "↓" : "↑")</span>
                        </button>
                    </th>
                }
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var feed in feeds)
            {
                <tr>
                    <td>
                        @if (feed.HasArtwork)
                        {
                            <img src="/media/feeds/@(feed.Id)/artwork" alt="" style="width: 2rem; height: 2rem; border-radius: 4px; object-fit: cover; vertical-align: middle;" />
                        }
                    </td>
                    <td>@feed.Title</td>
                    <td>@feed.Type</td>
                    <td>@feed.Slug</td>
                    <td>@feed.EpisodeCount</td>
                    <td title="@(feed.LatestEpisodeUtc is null ? null : DateTime.SpecifyKind(feed.LatestEpisodeUtc.Value, DateTimeKind.Utc).ToLocalTime().ToString("g"))">
                        @FormatAge(feed.LatestEpisodeUtc)
                    </td>
                    <td>
                        @(feed.LastRefreshedUtc?.ToLocalTime().ToString("g") ?? "never")
                        @if (feed.LastRefreshError is not null)
                        {
                            <span style="color: var(--vc-danger);" title="@feed.LastRefreshError">&#9888; failed</span>
                        }
                    </td>
                    <td>
                        @if (feed.Type == FeedType.Rss)
                        {
                            <input type="checkbox" checked="@feed.AutoDownloadEnabled" @onchange="e => ToggleAutoDownloadAsync(feed.Id, e)" />
                        }
                    </td>
                    <td>
                        @if (feed.Type == FeedType.Rss)
                        {
                            <input type="number" min="0" style="width: 5rem;"
                                   value="@(feed.KeepLastCount?.ToString() ?? "")"
                                   placeholder="@Config.DefaultKeepLastCount"
                                   @onchange="e => UpdateKeepLastCountAsync(feed.Id, e)" />
                        }
                    </td>
                    <td>
                        @if (pendingDeleteId == feed.Id)
                        {
                            <span>Delete this feed and all its data?</span>
                            <button class="danger" @onclick="() => ConfirmDeleteAsync(feed.Id)" disabled="@isDeleting">Yes, delete</button>
                            <button @onclick="CancelDelete" disabled="@isDeleting">Cancel</button>
                        }
                        else
                        {
                            <button @onclick="() => RefreshOneAsync(feed.Id)">Refresh</button>
                            <button class="danger" @onclick="() => RequestDelete(feed.Id)">Delete</button>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

</div>

@code {
    // Order here is the column order in the table header, and each Key is what lands in
    // config.json as AppConfig.FeedSortColumn -- renaming one resets that saved preference
    // to the first entry (title).
    private static readonly SortColumn[] SortColumns =
    [
        new("Title", "Title", DescendingFirst: false, r => r.Title),
        new("Type", "Type", DescendingFirst: false, r => r.Type.ToString()),
        new("Slug", "Slug", DescendingFirst: false, r => r.Slug),
        new("Episodes", "Episodes", DescendingFirst: true, r => r.EpisodeCount),
        new("LatestRelease", "Latest release", DescendingFirst: true, r => r.LatestEpisodeUtc),
        new("LastRefreshed", "Last refreshed", DescendingFirst: true, r => r.LastRefreshedUtc),
        new("AutoDownload", "Auto-download", DescendingFirst: true, r => r.AutoDownloadEnabled),
        new("KeepLast", "Keep last", DescendingFirst: true, r => r.KeepLastCount),
    ];

    private List<FeedRow>? feeds;
    private string newFeedUrl = string.Empty;
    private bool isAdding;
    private bool isRefreshing;
    private bool isDeleting;
    private int? pendingDeleteId;
    private string? statusMessage;
    private CancellationTokenSource cts = new();

    /// <summary>The saved sort column, falling back to title if config.json holds an unknown key.</summary>
    private SortColumn ActiveColumn => Array.Find(SortColumns, c => c.Key == Config.FeedSortColumn) ?? SortColumns[0];

    protected override async Task OnInitializedAsync() => await LoadFeedsAsync();

    private async Task LoadFeedsAsync()
    {
        await using var db = await DbContextFactory.CreateDbContextAsync(cts.Token);
        var rows = await db.Feeds
            .Select(f => new FeedRow(f.Id, f.Title ?? f.OriginalUrl, f.Type, f.Slug, f.Episodes.Count, f.Episodes.Max(e => (DateTime?)e.PublishedAtUtc), f.LastRefreshedUtc, f.AutoDownloadEnabled, f.KeepLastCount, f.LastRefreshError, f.ArtworkFileName != null))
            .ToListAsync(cts.Token);

        // Ordering happens here rather than in SQL: the feed list is small, and several
        // sortable columns (latest release, keep-last) are aggregates or nullable values
        // the provider would order differently than the rendered text. Title breaks ties
        // so equal values (e.g. two never-refreshed feeds) keep a stable order.
        var sorted = Config.FeedSortDescending
            ? rows.OrderByDescending(ActiveColumn.Selector).ThenBy(r => r.Title)
            : rows.OrderBy(ActiveColumn.Selector).ThenBy(r => r.Title);

        feeds = sorted.ToList();
    }

    private async Task SortByAsync(SortColumn column)
    {
        // Same column flips direction; a new column starts in the direction that reads
        // most naturally for it (A-Z for text, newest/largest first for dates and counts).
        Config.FeedSortDescending = Config.FeedSortColumn == column.Key
            ? !Config.FeedSortDescending
            : column.DescendingFirst;
        Config.FeedSortColumn = column.Key;
        Config.Save();
        await LoadFeedsAsync();
    }

    private async Task ToggleAutoDownloadAsync(int feedId, ChangeEventArgs e)
    {
        await using var db = await DbContextFactory.CreateDbContextAsync(cts.Token);
        var feed = await db.Feeds.FindAsync([feedId], cts.Token);
        if (feed is null)
        {
            return;
        }

        feed.AutoDownloadEnabled = e.Value is true;
        await db.SaveChangesAsync(cts.Token);
        await LoadFeedsAsync();
    }

    private async Task UpdateKeepLastCountAsync(int feedId, ChangeEventArgs e)
    {
        await using var db = await DbContextFactory.CreateDbContextAsync(cts.Token);
        var feed = await db.Feeds.FindAsync([feedId], cts.Token);
        if (feed is null)
        {
            return;
        }

        var text = e.Value as string;
        feed.KeepLastCount = string.IsNullOrWhiteSpace(text) ? null : int.Parse(text);
        await db.SaveChangesAsync(cts.Token);
        await LoadFeedsAsync();
    }

    private async Task AddFeedAsync()
    {
        if (string.IsNullOrWhiteSpace(newFeedUrl) || isAdding)
        {
            return;
        }

        isAdding = true;
        statusMessage = null;
        try
        {
            var result = await SubscriptionService.AddFeedAsync(newFeedUrl, cts.Token);
            statusMessage = result.Success
                ? $"Added with {result.EpisodeCount} episode(s)."
                : result.Error;

            if (result.Success)
            {
                newFeedUrl = string.Empty;
                await LoadFeedsAsync();
            }
        }
        finally
        {
            isAdding = false;
        }
    }

    private async Task RefreshAllAsync()
    {
        if (isRefreshing)
        {
            return;
        }

        isRefreshing = true;
        try
        {
            await RefreshService.RefreshAllAsync(cts.Token);
            await LoadFeedsAsync();
        }
        finally
        {
            isRefreshing = false;
        }
    }

    private async Task RefreshOneAsync(int feedId)
    {
        var result = await RefreshService.RefreshFeedAsync(feedId, cts.Token);
        statusMessage = result.Success ? $"Added {result.AddedCount} new episode(s)." : result.Error;
        await LoadFeedsAsync();
    }

    private void RequestDelete(int feedId)
    {
        pendingDeleteId = feedId;
        statusMessage = null;
    }

    private void CancelDelete() => pendingDeleteId = null;

    private async Task ConfirmDeleteAsync(int feedId)
    {
        if (isDeleting)
        {
            return;
        }

        isDeleting = true;
        try
        {
            await SubscriptionService.DeleteFeedAsync(feedId, cts.Token);
            statusMessage = "Feed deleted.";
            pendingDeleteId = null;
            await LoadFeedsAsync();
        }
        finally
        {
            isDeleting = false;
        }
    }

    public void Dispose()
    {
        cts.Cancel();
        cts.Dispose();
    }

    // The Max aggregate bypasses the UTC value converter, so re-stamp Kind here.
    private static string FormatAge(DateTime? publishedAtUtc)
    {
        if (publishedAtUtc is null)
        {
            return "never";
        }

        var elapsed = DateTime.UtcNow - DateTime.SpecifyKind(publishedAtUtc.Value, DateTimeKind.Utc);
        if (elapsed < TimeSpan.FromMinutes(1))
        {
            return "just now";
        }

        if (elapsed < TimeSpan.FromHours(1))
        {
            return Plural((int)elapsed.TotalMinutes, "minute");
        }

        if (elapsed < TimeSpan.FromDays(1))
        {
            return Plural((int)elapsed.TotalHours, "hour");
        }

        if (elapsed < TimeSpan.FromDays(30))
        {
            return Plural((int)elapsed.TotalDays, "day");
        }

        if (elapsed < TimeSpan.FromDays(365))
        {
            return Plural((int)(elapsed.TotalDays / 30), "month");
        }

        return Plural((int)(elapsed.TotalDays / 365), "year");

        static string Plural(int count, string unit) => $"{count} {unit}{(count == 1 ? "" : "s")} ago";
    }

    /// <summary>
    /// A clickable header: <paramref name="Key"/> is persisted, <paramref name="Selector"/>
    /// pulls the value the column renders (null sorts first ascending / last descending).
    /// </summary>
    private sealed record SortColumn(string Key, string Label, bool DescendingFirst, Func<FeedRow, IComparable?> Selector);

    private sealed record FeedRow(int Id, string Title, FeedType Type, string Slug, int EpisodeCount, DateTime? LatestEpisodeUtc, DateTime? LastRefreshedUtc, bool AutoDownloadEnabled, int? KeepLastCount, string? LastRefreshError, bool HasArtwork);
}
